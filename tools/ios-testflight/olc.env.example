# Copy this file to a private location outside git and fill in real values.

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=

# Optional for portal_prepare legacy App Group association. Fastlane may ask for Apple 2FA.
OLC_APPLE_ID=

# Optional when upload_to_testflight cannot infer the app by bundle id.
OLC_IOS_APPSTORE_APP_ID=
OLC_IOS_ITC_TEAM_ID=

# Optional overrides.
OLC_IOS_DEVELOPMENT_TEAM=2AQ4VTF696
OLC_IOS_APP_IDENTIFIER=com.oxi717.olc
OLC_IOS_TUNNEL_IDENTIFIER=com.oxi717.olc.tunnel
OLC_IOS_APP_GROUP=group.com.oxi717.olc
OLC_IOS_DISPLAY_NAME=OLC
OLC_IOS_TUNNEL_DISPLAY_NAME="OLC Tunnel"
OLC_IOS_APPSTORE_NAME=OLC
OLC_IOS_APPSTORE_SKU=olc-private
OLC_IOS_APP_VERSION=0.1.0
OLC_IOS_APP_PROFILE_NAME="OLC App Store"
OLC_IOS_TUNNEL_PROFILE_NAME="OLC Tunnel App Store"
OLC_IOS_CHANGELOG="Private field build"
OLC_IOS_CERTIFICATE_OUTPUT_DIR=

# Set to manual after certificates/profiles exist locally.
OLC_IOS_SIGNING_STYLE=manual

# Optional fallback to fastlane sigh instead of the default curl-based ASC profile flow.
OLC_IOS_USE_FASTLANE_SIGH=0
OLC_IOS_SKIP_CERTIFICATE_VERIFICATION=1

# Optional profile generation inputs for the local iOS app.
OLC_TELEMOST_SUBSCRIPTION_JSON=
OLC_WB_SRV_YAML=
OLC_WB_SUBSCRIPTION_JSON=
