[Unit]
Description=OLC managed WB rotation
After=network-online.target olc-control-plane-xray.service
Wants=network-online.target
Requires=olc-control-plane-xray.service

[Service]
Type=oneshot
User=olc-control-plane
Group=olc-control-plane
StateDirectory=olc-control-plane
WorkingDirectory=/opt/olc
UMask=0077
Environment=OLC_ROOT=/opt/olc
Environment=HTTPS_PROXY=http://127.0.0.1:1082
Environment=HTTP_PROXY=http://127.0.0.1:1082
Environment=NO_PROXY=127.0.0.1,localhost
LoadCredential=rotation.env:/etc/olc-control-plane/rotation.env
LoadCredential=ssh_key:/etc/olc-control-plane/ssh_key
LoadCredential=known_hosts:/etc/olc-control-plane/known_hosts
LoadCredential=managed-wb-rotation.json:/etc/olc-control-plane/managed-wb-rotation.json
LoadCredential=wb.bearer:/etc/olc-control-plane/wb.bearer
LoadCredential=wb.room:/etc/olc-control-plane/wb.room
LoadCredential=wb-server-base.yaml:/etc/olc-control-plane/wb-server-base.yaml
ExecStart=/opt/olc/control-plane/run-systemd-wb-rotation.sh
ExecStartPost=/opt/olc/control-plane/backup-systemd-state.sh
TimeoutStartSec=10min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
